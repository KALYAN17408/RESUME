# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Site URL for password recovery and email redirects
VITE_SITE_URL=http://localhost:5173

# Optional: Google Search Console Verification Meta Tag Token
# Required for Google Cloud OAuth Domain Ownership Verification
# Obtain from Google Search Console -> Settings -> Ownership verification -> HTML tag
VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here

# Optional: Dedicated Public Support Email (Displayed on Privacy Policy & Terms)
# Defaults to [RESUME_AI_SUPPORT_EMAIL] if unconfigured, keeping personal email protected
VITE_SUPPORT_EMAIL=support@theresume-ai.netlify.app
